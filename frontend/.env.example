# Copy to .env.local. All values are optional — the site works without them.

# Public site URL once a production domain is chosen (used for canonical/OG URLs).
VITE_SITE_URL=

# Backend API base URL (the deployed backend Vercel project), e.g.
#   VITE_API_URL=https://hexora-api.vercel.app
# Leave empty in development: Vite proxies /api to the local backend on :8787.
VITE_API_URL=

# How the inquiry form delivers messages: 'api' (default — backend API,
# email with PDF) or 'mailto' (opens the visitor's own email app).
VITE_INQUIRY_PROVIDER=

# Future Supabase integration (leave empty until a project is created).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
