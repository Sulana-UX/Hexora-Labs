# Copy to backend/.env for local development (git-ignored).
# In production add the same variables in Vercel → (backend project) → Settings → Environment Variables.
GMAIL_USER=hexoralabs@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
INQUIRY_TO=hexoralabs@gmail.com
# Website origins allowed to call the API (comma-separated). Add the live site URL in production,
# e.g. http://localhost:5173,https://hexora-labs.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
